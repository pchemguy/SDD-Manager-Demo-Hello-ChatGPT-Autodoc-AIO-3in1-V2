{
  "manifest_version": 3,
  "name": "Hello World Color Sidebar",
  "description": "Select the color of an isolated Hello World message on an activated webpage.",
  "version": "0.3.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "incognito": "not_allowed",
  "action": {
    "default_title": "Activate Hello World on this page"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Page color",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hello-world-color@pchemguy.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
